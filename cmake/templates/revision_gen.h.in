/**
 * Generated by cmake/GenerateRevision.cmake on every build - do not edit.
 *
 * The facts that move with the working tree, kept apart from version_gen.h so
 * that a new commit or a dirty flag only recompiles what reads them.
 */

#ifndef CS2SDKTEST_REVISION_GEN_H_
#define CS2SDKTEST_REVISION_GEN_H_

#define PLUGIN_FULL_VERSION     "@CS2SDKTEST_FULL_VERSION@"

/* Git description of the tree this binary was built from, or "unknown". */
#define PLUGIN_GIT_REVISION     "@CS2SDKTEST_GIT_REVISION@"

/* Full commit hash of HEAD, or "unknown". Source links on the results page pin
   to it, so they keep pointing at the code that ran even if a tag is moved. */
#define PLUGIN_GIT_COMMIT       "@CS2SDKTEST_GIT_COMMIT@"

/* The s2sdk commit (short hash and date) this binary was compiled against. */
#define PLUGIN_SDK_REVISION     "@CS2SDKTEST_SDK_REVISION@"

#endif /* CS2SDKTEST_REVISION_GEN_H_ */
