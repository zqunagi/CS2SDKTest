# Copy to /etc/cs2sdktest-ci.env on the test server (chmod 600). Never commit the real one.

GH_REPO="zqunagi/CS2SDKTest"
# Optional prefix for github.com downloads (release lookup + zip). Keep the trailing slash.
GH_PROXY="https://ghproxy.net/"

CS2_DIR="/srv/cs2"                # steamcmd force_install_dir; contains game/ and steamapps/
STATE_DIR="/var/lib/cs2sdktest-ci"   # last tested tag/buildid, runs/ output
APP_ID=730

# CS2 is kept current by another service; this CI only reads its build id.

# Seconds the whole server run may take before it is killed.
RUN_TIMEOUT=600
CST_AUTORUN_DELAY=15

# Command that starts the server; appended with the standard test arguments.
LAUNCH_CMD="$CS2_DIR/game/bin/linuxsteamrt64/cs2"
LAUNCH_ARGS="-dedicated +hostport 10001 +game_type 0 +game_mode 1 +map de_dust2 +sv_hibernate_when_empty 0 +sv_cheats 0 +bot_quota 1 +mp_warmup_pausetimer 1 +mp_freezetime 0 +mp_autoteambalance 0 +mp_limitteams 0 -insecure"

# Called as: PUBLISH_HOOK <run_dir>. Sanitises and pushes to the gh-pages branch.
PUBLISH_HOOK="/opt/cs2sdktest-ci/publish.py"
PAGES_TOKEN=""                    # fine-grained, Contents: read+write on this repo only
