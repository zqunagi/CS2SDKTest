{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (multi-config)",
      "description": "Visual Studio 2022 solution; pick Debug/Release at build time.",
      "inherits": "windows-base"
    },
    {
      "name": "windows-x64-ninja-debug",
      "displayName": "Windows x64 Ninja Debug",
      "description": "Requires a Developer Command Prompt (vcvars64) or the CMake Tools extension.",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-ninja-release",
      "displayName": "Windows x64 Ninja RelWithDebInfo",
      "inherits": "windows-x64-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 RelWithDebInfo",
      "description": "Ships debug info; symbols are what make a snapshot diff actionable.",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-x64-gcc-release",
      "displayName": "Linux x64 RelWithDebInfo (GCC)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "linux-make-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Unix Makefiles",
      "description": "For hosts without Ninja - a bare WSL install has make but not ninja.",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-x64-make-debug",
      "displayName": "Linux x64 Debug (Makefiles)",
      "inherits": "linux-make-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-x64-make-release",
      "displayName": "Linux x64 RelWithDebInfo (Makefiles)",
      "inherits": "linux-make-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-x64-make-gcc-release",
      "displayName": "Linux x64 RelWithDebInfo (Makefiles, GCC)",
      "inherits": "linux-make-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 RelWithDebInfo",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-x64-ninja-debug",
      "configurePreset": "windows-x64-ninja-debug"
    },
    {
      "name": "windows-x64-ninja-release",
      "configurePreset": "windows-x64-ninja-release"
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "linux-x64-gcc-release",
      "configurePreset": "linux-x64-gcc-release"
    },
    {
      "name": "linux-x64-make-debug",
      "configurePreset": "linux-x64-make-debug"
    },
    {
      "name": "linux-x64-make-release",
      "configurePreset": "linux-x64-make-release"
    },
    {
      "name": "linux-x64-make-gcc-release",
      "configurePreset": "linux-x64-make-gcc-release"
    }
  ]
}
